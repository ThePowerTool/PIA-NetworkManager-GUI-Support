client
dev tun
proto tcp
remote EXIT_HOST_PLACEHOLDER 501
socks-proxy 127.0.0.1 1080
data-ciphers AES-256-GCM:AES-128-GCM:AES-256-CBC
auth SHA256
comp-lzo no
remote-cert-tls server
nobind
persist-key
persist-tun
resolv-retry infinite
ca /etc/openvpn/pia-ca.rsa.4096.crt
auth-user-pass /root/.pia-auth
route-noexec
tun-mtu 1500
mssfix 1400
mtu-disc no
verb 3
